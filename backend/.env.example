# Server configuration
PORT=4000
MONGO_URL=your-mongodb-connection-string
JWT_SECRET=your-jwt-secret
SALT=10
STRIPE_SECRET_KEY=your-stripe-secret-key

# AI provider configuration
AI_API_KEY=your-api-key
AI_MODEL=gpt-4o-mini
# Uncomment to use a custom endpoint (e.g., an Azure/OpenAI-compatible proxy)
# AI_BASE_URL=https://api.example.com/v1

# Comma-separated list of allowed front-end origins for CORS (e.g., https://app.example.com,https://admin.example.com)
# Leave empty to allow all origins in development.
CORS_ORIGINS=
